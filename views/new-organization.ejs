<%- include('partials/header') %>
<section class="page-section">
  <div class="section-intro">
    <p class="eyebrow">New organization</p>
    <h1>Create Organization</h1>
  </div>
  <% if (typeof error !== 'undefined') { %>
    <p class="error"><%= error %></p>
  <% } %>
  <form action="/new-organization" method="POST" class="project-form">
    <p>
      <label for="name">Name:</label>
      <input type="text" id="name" name="name" required maxlength="150" minlength="3">
    </p>
    <p>
      <label for="description">Description:</label>
      <textarea id="description" name="description" required></textarea>
    </p>
    <p>
      <label for="image">Logo Filename:</label>
      <input type="text" id="image" name="image" required maxlength="255">
    </p>
    <p>
      <label for="website">Website:</label>
      <input type="url" id="website" name="website" maxlength="255">
    </p>
    <button type="submit" class="button">Create Organization</button>
  </form>
</section>
<%- include('partials/footer') %>
