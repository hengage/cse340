<%- include('partials/header') %>
<section class="page-section">
  <div class="section-intro">
    <p class="eyebrow">Edit project</p>
    <h1>Edit <%= project.title %></h1>
  </div>
  <form action="/edit-project/<%= project.project_id %>" method="POST" class="project-form">
    <p>
      <label for="title">Title:</label>
      <input type="text" id="title" name="title" value="<%= project.title %>" required>
    </p>
    <p>
      <label for="organization_id">Organization:</label>
      <select id="organization_id" name="organization_id" required>
        <% organizations.forEach(org => { %>
          <option value="<%= org.id %>" <%= org.id === project.organization_id ? 'selected' : '' %>><%= org.name %></option>
        <% }); %>
      </select>
    </p>
    <p>
      <label for="date">Date:</label>
      <input type="date" id="date" name="date" value="<%= new Date(project.date).toISOString().split('T')[0] %>" required>
    </p>
    <p>
      <label for="location">Location:</label>
      <input type="text" id="location" name="location" value="<%= project.location %>" required>
    </p>
    <p>
      <label for="description">Description:</label>
      <textarea id="description" name="description" required><%= project.description %></textarea>
    </p>
    <button type="submit" class="button">Update Project</button>
  </form>
</section>
<%- include('partials/footer') %>
