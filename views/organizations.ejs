<%- include('partials/header') %>
<section class="page-section">
  <div class="section-intro">
    <p class="eyebrow">Supporting service</p>
    <h1>Organizations</h1>
    <p>These organizations are making a positive impact through education, community support, and environmental stewardship.</p>
    <% if (isLoggedIn && user.role_name === 'admin') { %>
      <a href="/new-organization" class="button">Create New Organization</a>
    <% } %>
  </div>
  <div class="grid cards-grid">
    <% organizations.forEach((organization) => { %>
      <article class="card">
        <a href="/organization/<%= organization.id %>">
          <img src="/images/<%= organization.image %>" alt="Logo for <%= organization.name %>" />
        </a>
        <div class="card-body">
          <h2><a href="/organization/<%= organization.id %>"><%= organization.name %></a></h2>
          <p><%= organization.description %></p>
          <% if (isLoggedIn && user.role_name === 'admin') { %>
            <a href="/edit-organization/<%= organization.id %>" class="button-secondary">Edit</a>
          <% } %>
        </div>
      </article>
    <% }); %>
  </div>
</section>
<%- include('partials/footer') %>
