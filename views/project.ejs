<%- include('partials/header') %>
<section class="page-section">
  <div class="section-intro">
    <p class="eyebrow">Project details</p>
    <h1><%= project.title %></h1>
    <p><%= project.description %></p>
  </div>
  <div class="project-detail">
    <p><strong>Date:</strong> <%= project.date %></p>
    <p><strong>Location:</strong> <%= project.location %></p>
    <p>
      <strong>Organization:</strong>
      <a href="/organization/<%= project.organization_id %>"
        ><%= project.organization_name %></a
      >
    </p>
    <p>
      <strong>Categories:</strong>
      <% categories.forEach((category) => { %>
        <a href="/category/<%= category.id %>" class="category-tag"><%= category.name %></a>
      <% }); %>
      <% if (isLoggedIn && user.role_name === 'admin') { %>
        <br>
        <a href="/project/<%= project.project_id %>/assign-categories" class="button-secondary">Assign Categories</a>
      <% } %>
    </p>
    <% if (isLoggedIn && user.role_name === 'admin') { %>
      <p>
        <a href="/edit-project/<%= project.project_id %>" class="button">Edit Project</a>
      </p>
    <% } %>

    <% if (isLoggedIn) { %>
      <div class="volunteer-actions">
        <% if (isVolunteered) { %>
          <p>You are volunteering for this project.</p>
          <form action="/project/<%= project.project_id %>/remove-volunteer" method="POST">
            <button type="submit" class="button-secondary">Remove Volunteer Status</button>
          </form>
        <% } else { %>
          <form action="/project/<%= project.project_id %>/volunteer" method="POST">
            <button type="submit" class="button">Volunteer for this Project</button>
          </form>
        <% } %>
      </div>
    <% } %>
  </div>
</section>
<%- include('partials/footer') %>
