<%- include('partials/header') %>
<section class="page-section">
  <div class="section-intro">
    <p class="eyebrow">Service categories</p>
    <h1>Categories</h1>
    <p>Choose a category that matches your interests and explore related opportunities.</p>
    <a href="/new-category" class="button">Create New Category</a>
  </div>
  <ul class="category-list">
    <% categories.forEach((category) => { %>
      <li class="category-item card-style">
        <a href="/category/<%= category.id %>" class="card-link"></a>
        <div class="card-content">
          <h3><%= category.name %></h3>
          <p><%= category.description %></p>
          <% if (isLoggedIn && user.role_name === 'admin') { %>
            <a href="/edit-category/<%= category.id %>" class="button-secondary">Edit</a>
          <% } %>
        </div>
      </li>
    <% }); %>

  </ul>
</section>
<%- include('partials/footer') %>
