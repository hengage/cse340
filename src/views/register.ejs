<%- include('partials/header') %>
<section class="page-section">
  <div class="section-intro">
    <p class="eyebrow">Create account</p>
    <h1>Register</h1>
  </div>
  <% if (typeof error !== 'undefined') { %>
    <p class="error"><%= error %></p>
  <% } %>
  <form action="/register" method="POST" class="project-form">
    <p>
      <label for="name">Name:</label>
      <input type="text" id="name" name="name" required minlength="3" maxlength="100">
    </p>
    <p>
      <label for="email">Email:</label>
      <input type="email" id="email" name="email" required maxlength="100">
    </p>
    <p>
      <label for="password">Password:</label>
      <input type="password" id="password" name="password" required minlength="8" maxlength="100">
    </p>
    <p>
      <label for="passwordConfirm">Confirm Password:</label>
      <input type="password" id="passwordConfirm" name="passwordConfirm" required minlength="8" maxlength="100">
    </p>
    <button type="submit" class="button">Register</button>
  </form>
</section>
<%- include('partials/footer') %>
